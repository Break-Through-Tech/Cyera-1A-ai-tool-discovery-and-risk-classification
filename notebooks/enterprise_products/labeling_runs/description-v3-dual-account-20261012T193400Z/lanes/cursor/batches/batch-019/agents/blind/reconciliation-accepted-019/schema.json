{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "annotation_id",
    "description_sha256",
    "ai_status",
    "ai_type",
    "evidence_strength",
    "forced_decision",
    "ai_type_evidence_strength",
    "ai_type_forced_decision",
    "rationale",
    "ai_type_rationale",
    "evidence_spans",
    "ai_type_evidence_spans",
    "conflict_response"
  ],
  "properties": {
    "annotation_id": {
      "type": "string"
    },
    "description_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ai_status": {
      "enum": [
        "ai",
        "non_ai"
      ]
    },
    "ai_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "ai_native",
        "ai_enabled",
        null
      ]
    },
    "evidence_strength": {
      "enum": [
        "supported",
        "weak"
      ]
    },
    "forced_decision": {
      "type": "boolean"
    },
    "ai_type_evidence_strength": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "supported",
        "weak",
        null
      ]
    },
    "ai_type_forced_decision": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "ai_type_rationale": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_spans": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "ai_type_evidence_spans": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conflict_response": {
      "type": "string",
      "minLength": 1
    }
  }
}
